generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String   @default("Hudson")
  createdAt     DateTime @default(now())

  workouts      Workout[]
  templates     WorkoutTemplate[]
  bodyWeights   BodyWeight[]
  photos        ProgressPhoto[]
  deviceTokens  DeviceToken[]
  settings      UserSettings?
}

model Exercise {
  id            String   @id @default(cuid())
  name          String
  muscleGroup   String
  category      String
  isCustom      Boolean  @default(false)

  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]

  @@unique([name, muscleGroup])
}

model WorkoutTemplate {
  id            String   @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  exercises     TemplateExercise[]
}

model TemplateExercise {
  id            String   @id @default(cuid())
  templateId    String
  exerciseId    String
  sortOrder     Int
  defaultSets   Int      @default(3)
  defaultReps   Int      @default(10)

  template      WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise      Exercise        @relation(fields: [exerciseId], references: [id])
}

model Workout {
  id            String   @id @default(cuid())
  userId        String
  date          String
  startTime     DateTime
  endTime       DateTime?
  durationMs    Int?
  notes         String?
  templateName  String?
  avgHeartRate  Float?
  maxHeartRate  Float?
  caloriesBurned Float?

  user          User     @relation(fields: [userId], references: [id])
  exercises     WorkoutExercise[]

  @@index([userId, date])
}

model WorkoutExercise {
  id            String   @id @default(cuid())
  workoutId     String
  exerciseId    String
  sortOrder     Int
  notes         String?
  restTimerSec  Int?
  supersetTag   String?

  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  sets          ExerciseSet[]
}

model ExerciseSet {
  id                String   @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  weight            Float
  reps              Int
  setType           String   @default("normal")
  rpe               Float?
  isPersonalRecord  Boolean  @default(false)

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}

model BodyWeight {
  id            String   @id @default(cuid())
  userId        String
  date          String
  weight        Float
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model ProgressPhoto {
  id            String   @id @default(cuid())
  userId        String
  date          String
  imageUrl      String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique
  platform      String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  defaultRestTimerSec Int     @default(90)
  keepScreenAwake     Boolean @default(true)
  rpeTrackingEnabled  Boolean @default(false)
  availablePlates     String  @default("[45,35,25,10,5,2.5]")
  barWeight           Float   @default(45)

  user                User    @relation(fields: [userId], references: [id])
}
